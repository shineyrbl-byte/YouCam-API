# YouCam API key: https://yce.makeupar.com/api-console/en/api-keys/
# Leave empty to run with simulated scans.
YOUCAM_API_KEY=

# Anthropic API key for the AI judge. Leave empty to use template rulings.
ANTHROPIC_API_KEY=

# Set to 1 to force simulated scans even when a YouCam key is set (saves API units while developing).
DEMO_MODE=

# Soft daily caps on real YouCam scans for public deployments (over the cap, scans are simulated).
SCANS_PER_IP_PER_DAY=8
SCANS_PER_DAY=40
